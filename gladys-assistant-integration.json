{
  "manifest_version": 1,
  "type": "device",
  "name": "Alplakes",
  "description": {
    "en": "Water temperature of Alpine lakes (Léman, Annecy, Bourget…) and its forecast, by Eawag.",
    "fr": "Température de l'eau des lacs alpins (Léman, Annecy, Bourget…) et sa prévision, par l'Eawag.",
    "de": "Wassertemperatur der Alpenseen (Genfersee, Annecy, Bodensee…) und ihre Prognose, von der Eawag.",
    "es": "Temperatura del agua de los lagos alpinos (Lemán, Annecy, Bourget…) y su previsión, por el Eawag."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-alplakes:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-alplakes/main/cover.png",
  "categories": ["environment"],
  "countries": ["CH", "FR", "IT", "DE", "AT", "SI"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your lakes",
        "fr": "Vos lacs",
        "de": "Deine Seen",
        "es": "Sus lagos"
      },
      "description": {
        "en": "Follow the water temperature of Alpine lakes, simulated by Alplakes (Eawag) and refreshed every 3 hours. \"Find lakes\" below lists their names. Save, then create the devices in the Discover tab.",
        "fr": "Suivez la température de l'eau des lacs alpins, simulée par Alplakes (Eawag) et mise à jour toutes les 3 heures. « Chercher des lacs » ci-dessous liste leurs noms. Enregistrez, puis créez les appareils dans l'onglet Découverte.",
        "de": "Verfolge die Wassertemperatur der Alpenseen, simuliert von Alplakes (Eawag) und alle 3 Stunden aktualisiert. „Seen suchen“ unten listet ihre Namen auf. Speichere und lege dann die Geräte im Tab „Entdecken“ an.",
        "es": "Siga la temperatura del agua de los lagos alpinos, simulada por Alplakes (Eawag) y actualizada cada 3 horas. «Buscar lagos» más abajo lista sus nombres. Guarde y, después, cree los dispositivos en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-alplakes/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "lakes",
      "type": "string",
      "required": false,
      "default": "",
      "label": {
        "en": "Lakes",
        "fr": "Lacs",
        "de": "Seen",
        "es": "Lagos"
      },
      "placeholder": {
        "en": "Léman, Annecy, Bourget",
        "fr": "Léman, Annecy, Bourget",
        "de": "Genfersee, Thunersee",
        "es": "Léman, Annecy, Garda"
      },
      "description": {
        "en": "Names or keys, separated by commas (10 at most). One device per lake, from its 1D model.",
        "fr": "Noms ou clés, séparés par des virgules (10 au plus). Un appareil par lac, d'après son modèle 1D.",
        "de": "Namen oder Schlüssel, durch Kommas getrennt (höchstens 10). Ein Gerät pro See, aus seinem 1D-Modell.",
        "es": "Nombres o claves, separados por comas (10 como máximo). Un dispositivo por lago, según su modelo 1D."
      }
    },
    {
      "key": "points",
      "type": "string",
      "required": false,
      "default": "",
      "label": {
        "en": "Precise points (optional)",
        "fr": "Points précis (facultatif)",
        "de": "Genaue Punkte (optional)",
        "es": "Puntos precisos (opcional)"
      },
      "placeholder": {
        "en": "Léman: 46.2107, 6.1613 Bains des Pâquis",
        "fr": "Léman: 46.2107, 6.1613 Bains des Pâquis",
        "de": "Léman: 46.2107, 6.1613 Bains des Pâquis",
        "es": "Léman: 46.2107, 6.1613 Bains des Pâquis"
      },
      "description": {
        "en": "A beach or a harbour: \"lake: latitude, longitude name\", separated by semicolons (10 at most). Only for the lakes with a 3D model.",
        "fr": "Une plage ou un port : « lac: latitude, longitude nom », séparés par des points-virgules (10 au plus). Seulement pour les lacs qui ont un modèle 3D.",
        "de": "Ein Strand oder ein Hafen: „See: Breite, Länge Name“, durch Semikolons getrennt (höchstens 10). Nur für Seen mit 3D-Modell.",
        "es": "Una playa o un puerto: «lago: latitud, longitud nombre», separados por punto y coma (10 como máximo). Solo para los lagos con modelo 3D."
      }
    },
    {
      "key": "depth",
